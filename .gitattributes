# 换行符统一，避免 Windows 上检出 CRLF、别处检出 LF 造成假 diff。
# 作者在 Windows 上开发，但仓库面向所有平台。
* text=auto eol=lf

# 明确指定为文本的扩展名
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf

# PowerShell 脚本给 Windows 用，留 CRLF
*.ps1   text eol=crlf

# 已构建产物：不要当文本处理，也不要合并冲突
lib/client.js  -text -diff
lib/index.js   -text -diff

# 图片二进制
*.png binary
*.jpg binary
*.svg text eol=lf
